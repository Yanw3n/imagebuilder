# Keep the requested Argon theme in recovery as inherited from common.config.

# Essential recovery services
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_dnsmasq=y

# Basic local display and shell tools
CONFIG_PACKAGE_fbtest=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_nano=y

# Exclude proxy userspace and optional diagnostics inherited from common.config.
# Keep shared networking kernel modules so recovery uses compatible kernel capabilities.
# CONFIG_PACKAGE_wireguard-tools is not set
# CONFIG_PACKAGE_luci-proto-wireguard is not set
# CONFIG_PACKAGE_nvme-cli is not set
# CONFIG_PACKAGE_smartmontools is not set
