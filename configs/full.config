# Proxy: daed only (managed via luci-app-daede). No standalone dae package.
CONFIG_PACKAGE_daed=y
# CONFIG_PACKAGE_dae is not set
CONFIG_PACKAGE_luci-app-daede=y
CONFIG_PACKAGE_adguardhome=y

# Clash / PassWall (no iStore app store)
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-passwall=y

# Remote access and administration
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y

# Dynamic DNS, connectivity watchdog, and KMS
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_watchcat=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-app-vlmcsd=y

# Python runtime capabilities
CONFIG_PACKAGE_python3=y
CONFIG_PACKAGE_python3-pip=y
CONFIG_PACKAGE_python3-openssl=y
CONFIG_PACKAGE_python3-sqlite3=y

# Argon configuration and separate Simplified Chinese LuCI translations.
# luci-app-daede embeds its own daede.zh-cn.lmo in the locked package.
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y

# Wired-router, storage, and diagnostics tools
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_pciutils=y
