"Content-Transfer-Encoding: 8bit\n"

msgid "Fan Control"
msgstr "风扇控制"

msgid "Configure automatic CPU cooling. The controller resolves pwmfan and CPU thermal paths on every start."
msgstr "配置自动 CPU 散热。控制器会在每次启动时解析 pwmfan 和 CPU 温度路径。"

msgid "Enable fan control"
msgstr "启用风扇控制"

msgid "Mode"
msgstr "模式"

msgid "Silent"
msgstr "静音"

msgid "Balanced"
msgstr "均衡"

msgid "Performance"
msgstr "性能"

msgid "Custom curve"
msgstr "自定义曲线"

msgid "Manual duty"
msgstr "手动占空比"

msgid "Manual duty (%)"
msgstr "手动占空比 (%)"

msgid "Polling interval (seconds)"
msgstr "轮询间隔（秒）"

msgid "%s curve"
msgstr "%s 曲线"

msgid "Comma-separated temperature:duty points, for example 30:20,45:40,60:65,75:100. Temperatures must increase and duty must be 0–100."
msgstr "以逗号分隔的温度:占空比点，例如 30:20,45:40,60:65,75:100。温度必须递增，占空比必须在 0–100 之间。"

msgid "Use increasing temperature:duty points with duty between 0 and 100."
msgstr "请使用递增的温度:占空比点，占空比必须在 0 到 100 之间。"

msgid "Status"
msgstr "状态"

msgid "Restart fan controller"
msgstr "重启风扇控制器"

msgid "Configuration applied and fan controller restarted."
msgstr "配置已应用，风扇控制器已重启。"

msgid "Fan controller restarted."
msgstr "风扇控制器已重启。"

msgid "Fan controller restart failed."
msgstr "风扇控制器重启失败。"

msgid "Could not apply fan configuration: %s"
msgstr "无法应用风扇配置：%s"

msgid "Could not restart fan controller: %s"
msgstr "无法重启风扇控制器：%s"

msgid "Unavailable: %s"
msgstr "不可用：%s"

msgid "Running — %s°C, %s%% duty (%s/255), %s mode"
msgstr "运行中 — %s°C，%s%% 占空比（%s/255），%s 模式"

msgid "Disabled"
msgstr "已禁用"

msgid "Stopped (safe PWM: %s/255)"
msgstr "已停止（安全 PWM：%s/255）"
