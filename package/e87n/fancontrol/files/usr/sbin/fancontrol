#!/bin/sh
# SPDX-License-Identifier: MIT

NAME=fancontrol
HWMON_ROOT=${HWMON_ROOT:-/sys/class/hwmon}
THERMAL_ROOT=${THERMAL_ROOT:-/sys/class/thermal}
STATUS_FILE=${STATUS_FILE:-/var/run/fancontrol/status.json}
UCI_BIN=${UCI_BIN:-uci}
fan_file=
safe_fan_file=
thermal_file=
reload_requested=0

log() {
	if [ -n "${FANCONTROL_LOG:-}" ]; then
		printf '%s\n' "$*" >> "$FANCONTROL_LOG"
	else
		logger -t "$NAME" -- "$*"
	fi
}

write_status() {
	mkdir -p "$(dirname "$STATUS_FILE")"
	printf '%s\n' "$1" > "$STATUS_FILE"
}

is_uint() {
	case "$1" in ''|*[!0-9]*) return 1 ;; esac
	return 0
}

uci_get() {
	value=$($UCI_BIN -q get "fancontrol.settings.$1" 2>/dev/null || true)
	[ -n "$value" ] && printf '%s\n' "$value" || printf '%s\n' "$2"
}

load_config() {
	[ "${FANCONTROL_LIBRARY:-0}" = 1 ] && return 0
	enable=$(uci_get enable 1)
	mode=$(uci_get mode balanced)
	manual_speed=$(uci_get manual_speed 50)
	interval=$(uci_get interval 5)
	curve_silent=$(uci_get curve_silent '30:0,45:20,60:45,75:100')
	curve_balanced=$(uci_get curve_balanced '30:20,45:40,60:65,75:100')
	curve_performance=$(uci_get curve_performance '30:45,45:65,60:85,75:100')
	curve_custom=$(uci_get curve_custom '30:20,45:40,60:65,75:100')
}

normalize_mode() {
	case "$mode" in
		0) mode=silent ;; 1) mode=balanced ;; 2) mode=performance ;;
		3) mode=custom ;; 4) mode=manual ;;
		silent|balanced|performance|custom|manual) ;;
		*) return 1 ;;
	esac
}

validate_curve() {
	awk -v curve="$1" '
	BEGIN {
		if (curve == "") exit 1
		n = split(curve, points, ","); previous = -1
		for (i = 1; i <= n; i++) {
			if (split(points[i], pair, ":") != 2 ||
				pair[1] !~ /^[0-9]+$/ || pair[2] !~ /^[0-9]+$/) exit 1
			t = pair[1] + 0; s = pair[2] + 0
			if (t <= previous || t > 130 || s > 100) exit 1
			previous = t
		}
	}'
}

validate_config() {
	is_uint "$enable" && [ "$enable" -le 1 ] || return 1
	normalize_mode || return 1
	is_uint "$manual_speed" && [ "$manual_speed" -le 100 ] || return 1
	is_uint "$interval" && [ "$interval" -ge 1 ] && [ "$interval" -le 60 ] || return 1
	validate_curve "$curve_silent" && validate_curve "$curve_balanced" && \
		validate_curve "$curve_performance" && validate_curve "$curve_custom"
}

resolve_hardware() {
	fan_file=
	thermal_file=
	for h in "$HWMON_ROOT"/hwmon*; do
		[ -r "$h/name" ] || continue
		[ "$(cat "$h/name" 2>/dev/null)" = pwmfan ] || continue
		[ -w "$h/pwm1" ] || continue
		fan_file="$h/pwm1"
		safe_fan_file="$fan_file"
		break
	done
	if [ -z "$fan_file" ]; then
		log 'pwmfan pwm1 not found; refusing to use a stale PWM path'
		safe_stop
		write_status '{"running":false,"error":"pwmfan pwm1 not found"}'
		return 1
	fi
	for zone in "$THERMAL_ROOT"/thermal_zone*; do
		[ -r "$zone/type" ] && [ -r "$zone/temp" ] || continue
		case "$(cat "$zone/type" 2>/dev/null)" in *[Cc][Pp][Uu]*) thermal_file="$zone/temp"; break ;; esac
	done
	if [ -z "$thermal_file" ]; then
		log 'CPU thermal zone not found; setting the last known PWM to full speed'
		safe_stop 'CPU thermal zone not found'
		return 1
	fi
}

interpolate_curve() {
	awk -v curve="$1" -v temp="$2" '
	BEGIN {
		n = split(curve, p, ",")
		for (i = 1; i <= n; i++) { split(p[i], q, ":"); t[i] = q[1] + 0; s[i] = q[2] + 0 }
		if (temp <= t[1]) { print s[1]; exit }
		for (i = 2; i <= n; i++) if (temp <= t[i]) {
			print int(s[i-1] + (temp - t[i-1]) * (s[i] - s[i-1]) / (t[i] - t[i-1]) + 0.5); exit
		}
		print s[n]
	}'
}

percent_to_pwm() {
	awk -v percent="$1" 'BEGIN { print int((percent * 255 / 100) + 0.5) }'
}

curve_for_mode() {
	case "$mode" in
		silent) printf '%s\n' "$curve_silent" ;; balanced) printf '%s\n' "$curve_balanced" ;;
		performance) printf '%s\n' "$curve_performance" ;; custom) printf '%s\n' "$curve_custom" ;;
	esac
}

safe_stop() {
	reason=${1:-}
	if [ -n "$safe_fan_file" ] && [ -w "$safe_fan_file" ]; then
		printf '255\n' > "$safe_fan_file"
	fi
	if [ -n "$reason" ]; then
		write_status "{\"running\":false,\"safe_pwm\":255,\"error\":\"$reason\"}"
		log "safe stop: $reason"
	else
		write_status '{"running":false,"safe_pwm":255}'
		log 'safe stop: requested full PWM before exit'
	fi
}

apply_once() {
	temp_milli=$(cat "$thermal_file" 2>/dev/null) || return 1
	is_uint "$temp_milli" || return 1
	temp_c=$((temp_milli / 1000))
	if [ "$mode" = manual ]; then speed=$manual_speed; else speed=$(interpolate_curve "$(curve_for_mode)" "$temp_c"); fi
	is_uint "$speed" && [ "$speed" -le 100 ] || return 1
	pwm=$(percent_to_pwm "$speed")
	[ -w "$fan_file" ] || return 1
	printf '%s\n' "$pwm" > "$fan_file" || return 1
	write_status "{\"running\":true,\"temperature\":$temp_c,\"duty\":$speed,\"pwm\":$pwm,\"mode\":\"$mode\"}"
}

run() {
	load_config
	validate_config || { log 'invalid UCI configuration'; write_status '{"running":false,"error":"invalid configuration"}'; return 1; }
	[ "$enable" = 1 ] || { write_status '{"running":false,"disabled":true}'; return 0; }
	resolve_hardware || return 1
	trap 'safe_stop; exit 0' INT TERM
	trap 'reload_requested=1' HUP
	while :; do
		if [ "$reload_requested" = 1 ]; then reload_requested=0; load_config; validate_config || { safe_stop 'invalid configuration after reload'; return 1; }; fi
		[ "$enable" = 1 ] || { safe_stop; return 0; }
		resolve_hardware || return 1
		apply_once || { log 'control cycle failed; switching to safe full PWM'; safe_stop; return 1; }
		sleep "$interval"
	done
}

case "${FANCONTROL_LIBRARY:-0}" in 1) ;; *) run "$@" ;; esac
